# Coloque na raiz do monorepo (`.env` ou `.env.local`).
# O Vite do game lê da raiz via `envDir` em apps/game/vite.config.ts.
# Dashboard → Project Settings → API
#
# GitHub Actions:
#   ENV_FILE  → conteúdo deste arquivo (obrigatório no deploy online)
#   VITE_BASE → opcional; padrão /nome-do-repo/ no GitHub Pages
#               use "/" se o site for user.github.io ou domínio customizado

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
